<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="6.0" method="upgrade">
	<name>COM_THAPI</name>
	<version>1.0.73</version>
	<description>COM_THAPI_XML_DESCRIPTION</description>
	<namespace path="src">ThApi\Component\ThApi</namespace>

	<administration>
		<!-- Nazwa pozycji w menu administratora: COM_THAPI_MENU (sys.ini) -->
		<menu>COM_THAPI_MENU</menu>

		<files folder="admin">
			<folder>src</folder>
			<folder>tmpl</folder>
			<folder>services</folder>
			<folder>forms</folder>
			<folder>layouts</folder>
			<folder>language</folder>
			<filename>config.xml</filename>
		</files>

		<languages folder="admin">
			<language tag="en-GB">language/en-GB/en-GB.com_thapi.ini</language>
			<language tag="en-GB">language/en-GB/en-GB.com_thapi.sys.ini</language>
			<language tag="pl-PL">language/pl-PL/pl-PL.com_thapi.ini</language>
			<language tag="pl-PL">language/pl-PL/pl-PL.com_thapi.sys.ini</language>
		</languages>
	</administration>

	<routes>
		<route type="application" path="site">
			<controller>api</controller>
			<defaults>
				<format>raw</format>
			</defaults>
		</route>
	</routes>

	<files folder="site">
		<folder>src</folder>
	</files>

</extension>
